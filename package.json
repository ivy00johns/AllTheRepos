{
  "name": "alltherepos",
  "version": "0.1.6",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm electron:dev",
    "build": "pnpm electron:build",
    "start": "pnpm electron:preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "db:generate": "drizzle-kit generate",
    "test": "node scripts/ensure-native-abi.mjs host && vitest run",
    "test:watch": "node scripts/ensure-native-abi.mjs host && vitest",
    "test:report": "node scripts/ensure-native-abi.mjs host && vitest run --reporter=default --reporter=json --outputFile=.vitest-results.json",
    "test:electron-e2e": "node scripts/ensure-native-abi.mjs electron && node scripts/run-electron-e2e.mjs",
    "test:packaged-update": "ATR_PACKAGED_UPDATE_E2E=1 playwright test --config playwright.electron.config.ts packaged-update-check",
    "test:full": "pnpm test && pnpm test:electron-e2e",
    "electron:rebuild": "node scripts/ensure-native-abi.mjs electron",
    "electron:dev": "pnpm electron:rebuild && electron-vite dev",
    "electron:build": "electron-vite build",
    "electron:preview": "electron-vite preview",
    "electron:pack": "pnpm electron:rebuild && electron-vite build && electron-builder --mac --dir",
    "electron:pack-older": "node scripts/ensure-native-abi.mjs electron && electron-vite build && electron-builder --mac --dir -c.directories.output=release/older -c.extraMetadata.version=0.0.1",
    "electron:dist": "pnpm electron:rebuild && electron-vite build && electron-builder --mac",
    "electron:dist:signed": "pnpm electron:rebuild && electron-vite build && IDENTITY=\"$(node scripts/signing-identity.mjs --require)\" && ATR_NOTARIZE=require electron-builder --mac -c.mac.identity=\"$IDENTITY\"",
    "release:check": "node scripts/release-notes.mjs",
    "release:next": "node scripts/next-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "links:check": "node scripts/check-doc-links.mjs",
    "first-launch:write": "node scripts/first-launch.mjs --write",
    "first-launch:check": "node scripts/first-launch.mjs --check && node scripts/check-first-launch-advice.mjs",
    "badges": "pnpm test:report && node scripts/make-test-badge.mjs .vitest-results.json",
    "icons": "node scripts/make-icons.mjs",
    "release": "pnpm release:check && pnpm icons && pnpm electron:rebuild && electron-vite build && electron-builder --mac --publish always && pnpm release:verify"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.169.2",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cytoscape": "^3.34.1",
    "cytoscape-fcose": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.3",
    "find-git-repositories": "^0.2.2",
    "git-url-parse": "^16.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.544.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.67",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@tanstack/router-devtools": "^1.166.13",
    "@tanstack/router-plugin": "^1.167.35",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.17.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19.0 <21 || >=22"
  }
}
