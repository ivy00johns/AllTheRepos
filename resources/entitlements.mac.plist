<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron's V8 JIT. Per plan §6 / Appendix C. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Keep unsigned-executable-memory disabled; V8 JIT does not need it. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <false/>

  <!-- Required when loading prebuilt unsigned dylibs (LanceDB native bindings). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Required for osascript / iTerm2 / Terminal control via AppleScript. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
